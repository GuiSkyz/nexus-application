# ==========================================
# NexusOps Operational Compliance Platform
# .env.example - Configurações de Ambiente
# ==========================================
# NOTA: Copie este arquivo para .env e preencha com valores seguros no seu ambiente local/produção.
# NUNCA versione o arquivo .env com credenciais reais.

# ------------------------------------------
# Configurações de Ambiente e Aplicação
# ------------------------------------------
ENVIRONMENT=development
APP_NAME=NexusOps
APP_VERSION=0.1.0
DEBUG=true

# ------------------------------------------
# API (FastAPI) - apps/api
# ------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_very_long_random_secure_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------
# PostgreSQL (Fonte Oficial da Verdade)
# ------------------------------------------
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=nexusops_user
POSTGRES_PASSWORD=nexusops_secure_pass
POSTGRES_DB=nexusops_db
# URL format para o SQLAlchemy (Async / Sync)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_SYNC_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------
# Redis (Cache, Filas, Revogação e Rate Limiting)
# ------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=nexusops_redis_secure_pass
REDIS_DB=0
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
# Prefixos e TTL
REDIS_KEY_PREFIX=nexusops:
REDIS_CACHE_TTL=3600

# ------------------------------------------
# MinIO (Armazenamento de Arquivos/Evidências/PDFs)
# ------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=nexusops_minio_admin
MINIO_ROOT_PASSWORD=nexusops_minio_secure_pass
MINIO_DEFAULT_BUCKET=nexusops-storage
MINIO_USE_SSL=false

# ------------------------------------------
# Aplicação Web (Next.js) - apps/web
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=NexusOps

# ------------------------------------------
# Aplicação Mobile (Expo / React Native) - apps/mobile
# ------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_APP_NAME=NexusOps
