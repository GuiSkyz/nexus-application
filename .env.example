# Copie este arquivo para .env.
# Cada máquina possui seu próprio .env; nunca versione credenciais reais.

# Identidade do ambiente
COMPOSE_PROJECT_NAME=nexusops
ENVIRONMENT=development
APP_NAME=NexusOps
APP_VERSION=0.2.0
DEBUG=true

# Entrada HTTP única
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
API_WORKERS=2

# API
SECRET_KEY=change_this_to_a_random_secret_with_at_least_64_characters_before_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:8080

# PostgreSQL
POSTGRES_USER=nexusops_user
POSTGRES_PASSWORD=nexusops_secure_pass
POSTGRES_DB=nexusops_db

# Redis
REDIS_PASSWORD=nexusops_redis_secure_pass
REDIS_DB=0
REDIS_KEY_PREFIX=nexusops:
REDIS_CACHE_TTL=3600

# MinIO
MINIO_ROOT_USER=nexusops_minio_admin
MINIO_ROOT_PASSWORD=nexusops_minio_secure_pass
MINIO_DEFAULT_BUCKET=nexusops-storage

# Clientes
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_NAME=NexusOps
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
EXPO_PUBLIC_APP_NAME=NexusOps
