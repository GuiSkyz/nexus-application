ENVIRONMENT=production
APP_NAME=NexusOps
APP_VERSION=0.2.0
APP_DOMAIN=nexusops.example.com

SECRET_KEY=replace-with-at-least-64-random-characters

POSTGRES_USER=nexusops
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=nexusops

REDIS_PASSWORD=replace-with-a-strong-redis-password

MINIO_ROOT_USER=nexusops-storage
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
MINIO_DEFAULT_BUCKET=nexusops-storage

CORS_ORIGINS=https://nexusops.example.com
NEXT_PUBLIC_API_URL=/api/v1
